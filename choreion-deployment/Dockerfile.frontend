# Dockerfile for Frontend with Nginx (ARM64/v8)

FROM --platform=linux/arm64/v8 nginx:alpine

# Install wget for health checks
RUN apk add --no-cache wget

# Copy frontend static files
COPY choreion-frontend/src/main /usr/share/nginx/html

# Copy custom nginx configuration
COPY choreion-deployment/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/index.html || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
